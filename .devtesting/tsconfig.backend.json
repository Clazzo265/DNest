{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"], "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@appdeploy/sdk": ["./sdk/index.ts"]
    }
  },
  "include": ["../backend/**/*.ts", "./sdk/index.ts"]
}
